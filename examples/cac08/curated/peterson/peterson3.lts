property
PROPERTY_MUTUAL_EXCLUSION = Q0,
	Q0	= (exit_critical[1..3] -> ERROR
		  |enter_critical[3] -> Q1
		  |enter_critical[2] -> Q2
		  |enter_critical[1] -> Q3),
	Q1	= ({enter_critical[1..3], exit_critical[1..2]} -> ERROR
		  |exit_critical[3] -> Q0),
	Q2	= ({enter_critical[1..3], exit_critical.{[1], [3]}} -> ERROR
		  |exit_critical[2] -> Q0),
	Q3	= ({enter_critical[1..3], exit_critical[2..3]} -> ERROR
		  |exit_critical[1] -> Q0).
