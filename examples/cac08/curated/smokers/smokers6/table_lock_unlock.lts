TASK_SUPPLIER = START,
  START =
    ( client[0].table_lock -> PUTTING_ITEMS[1][1]
    | client[0].table_lock -> PUTTING_ITEMS[2][1]
    | client[0].table_lock -> PUTTING_ITEMS[3][1]
    | client[0].table_lock -> PUTTING_ITEMS[4][1]
    | client[0].table_lock -> PUTTING_ITEMS[5][1]
    | client[0].table_lock -> PUTTING_ITEMS[6][1]
    ),

  PUTTING_ITEMS[skip:SMOKER_RANGE][current:SMOKER_RANGE] =
    ( when ((current == skip) && (current == SMOKERS)) internal               -> DONE
    | when ((current == skip) && (current != SMOKERS)) internal               -> PUTTING_ITEMS[skip][current + 1]
    | when ((current != skip) && (current == SMOKERS)) client[0].put[current] -> DONE
    | when ((current != skip) && (current != SMOKERS)) client[0].put[current] -> PUTTING_ITEMS[skip][current + 1]
    ),

  DONE = (client[0].put_items -> client[0].table_unlock -> client[c:SMOKER_RANGE].done_assembling -> START)
  + {client[0].{{does_not_have, get, has, put}[1..SMOKERS], {table_lock, table_unlock}}} \ {internal}.

