minimal
TASK_operator = START[0][0],
  START[ac1:CUSTOMER_COUNTER][ac2:CUSTOMER_COUNTER] =
    ( when (ac1 < CUSTOMERS) operator[cust:CUSTOMER_RANGE][1].prepay -> PREPAYING[ac1][ac2][cust][1]
    | when (ac2 < CUSTOMERS) operator[cust:CUSTOMER_RANGE][2].prepay -> PREPAYING[ac1][ac2][cust][2]
    | when (ac1 > 0) operator[1][cust:CUSTOMER_RANGE].charge -> DECREMENT[ac1][ac2][cust][1]
    | when (ac2 > 0) operator[2][cust:CUSTOMER_RANGE].charge -> DECREMENT[ac1][ac2][cust][2]
    ),

  DECREMENT[ac1:CUSTOMER_COUNTER][ac2:CUSTOMER_COUNTER][cust:CUSTOMER_RANGE][pump:PUMP_RANGE] =
    ( when (pump == 1) internal -> REACTIVATING[ac1 - 1][ac2][cust][pump]
    | when (pump == 2) internal -> REACTIVATING[ac1][ac2 - 1][cust][pump]
    ),

  REACTIVATING[ac1:CUSTOMER_COUNTER][ac2:CUSTOMER_COUNTER][cust:CUSTOMER_RANGE][pump:PUMP_RANGE] =
    ( when ((pump == 1) && (ac1 == 0)) internal -> CHANGE[ac1][ac2][cust][pump]
    | when ((pump == 1) && (ac1 != 0)) pump[pump].activate -> CHANGE[ac1][ac2][cust][pump]
    | when ((pump == 2) && (ac2 == 0)) internal -> CHANGE[ac1][ac2][cust][pump]
    | when ((pump == 2) && (ac2 != 0)) pump[pump].activate -> CHANGE[ac1][ac2][cust][pump]
    ),

  CHANGE[ac1:CUSTOMER_COUNTER][ac2:CUSTOMER_COUNTER][cust:CUSTOMER_RANGE][pump:PUMP_RANGE] =
    ( customer[pump][cust].change -> START[ac1][ac2]
    ),

  PREPAYING[ac1:CUSTOMER_COUNTER][ac2:CUSTOMER_COUNTER][cust:CUSTOMER_RANGE][pump:PUMP_RANGE] =
    ( when ((pump == 1) && (ac1 == 0)) pump[pump].activate -> END_PREPAY[ac1 + 1][ac2][cust]
    | when ((pump == 1) && (ac1 != 0)) internal -> END_PREPAY[ac1 + 1][ac2][cust]
    | when ((pump == 2) && (ac2 == 0)) pump[pump].activate -> END_PREPAY[ac1][ac2 + 1][cust]
    | when ((pump == 2) && (ac2 != 0)) internal -> END_PREPAY[ac1][ac2 + 1][cust]
    ),

  END_PREPAY[ac1:CUSTOMER_COUNTER][ac2:CUSTOMER_COUNTER][cust:CUSTOMER_RANGE] =
     ( operator[cust].prepay_end -> START[ac1][ac2]
     ) \ {internal}.

